#!name=Oclean 欧可林去广告与隐私防追踪
#!desc=去除 Oclean (欧可林) App 启动开屏广告、弹窗推广及第三方数据追踪 SDK (友盟/Bugly/Mob)。
#!author=Minis
#!system=ios

[Rule]
# > Oclean 广告/开屏/推广配置与资源域名
DOMAIN-SUFFIX, zztfly.com, REJECT

# > 第三方追踪/统计/SDK
DOMAIN-SUFFIX, umeng.com, REJECT
DOMAIN-SUFFIX, umengcloud.com, REJECT
DOMAIN-SUFFIX, mob.com, REJECT
DOMAIN, ios.bugly.qq.com, REJECT

[URL Rewrite]
# > Oclean 主 API 中的开屏广告/推广拦截 (返回 200 空数据)
^https?:\/\/careapi\.oclean\.com\/(api\/)?(ad|advert|splash|popup|banner|launch)\b _reject_200

[MITM]
hostname = %APPEND% careapi.oclean.com
