#!name=Oclean 欧可林去广告与隐私防追踪 (脚本增强版)
#!desc=通过 JS 脚本深度清洗 Oclean App 启动时的开屏广告与弹窗数据。
#!author=Minis
#!system=ios

[Rule]
# > 确保 Oclean 核心域名走代理/MitM解密，不被 DIRECT 旁路
DOMAIN, careapi.oclean.com, PROXY
DOMAIN-SUFFIX, zztfly.com, REJECT, no-resolve

# > 第三方追踪/统计 SDK 拦截
DOMAIN-SUFFIX, umeng.com, REJECT, no-resolve
DOMAIN-SUFFIX, umengcloud.com, REJECT, no-resolve
DOMAIN-SUFFIX, mob.com, REJECT, no-resolve
DOMAIN, ios.bugly.qq.com, REJECT, no-resolve

[Script]
# > 拦截 Oclean 初始化及用户数据接口，清空开屏/弹窗广告字段
Oclean_Ad_Clean = type=http-response,pattern=^https?:\/\/careapi\.oclean\.com\/.*,script-path=https://raw.githubusercontent.com/minis/workspace/oclean_clean.js,requires-body=true,max-size=524288

[MITM]
hostname = %APPEND% careapi.oclean.com, *.zztfly.com
