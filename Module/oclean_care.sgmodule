#!name=Oclean 欧可林去广告与隐私防追踪
#!desc=深度去除 Oclean (欧可林) App 启动开屏广告、弹窗推广及第三方数据追踪 SDK (友盟/Bugly/Mob)。安装后请强退并重启 App 以清除本地图片缓存。
#!author=Minis
#!system=ios

[Rule]
# > Oclean 核心广告/推广/资源域名 (加 no-resolve 加速阻断)
DOMAIN-SUFFIX, zztfly.com, REJECT, no-resolve
DOMAIN-SUFFIX, oclean.com, DIRECT

# > 第三方数据收集与追踪 SDK
DOMAIN-SUFFIX, umeng.com, REJECT, no-resolve
DOMAIN-SUFFIX, umengcloud.com, REJECT, no-resolve
DOMAIN-SUFFIX, mob.com, REJECT, no-resolve
DOMAIN, ios.bugly.qq.com, REJECT, no-resolve

[URL Rewrite]
# > 阻断 zztfly.com 旗下所有广告 API (如 /suba/list 等)
^https?:\/\/(.*)\.zztfly\.com\/ _reject_200

# > Oclean 主 API 中的开屏广告/推广/弹窗拦截
^https?:\/\/careapi\.oclean\.com\/.*(ad|advert|splash|popup|banner|launch|notice|recommend)\b _reject_200

[MITM]
hostname = %APPEND% careapi.oclean.com, *.zztfly.com
